# Optional NPC model. Leave unset: the game uses its written, in-character fallback replies.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional Zhihu OAuth. Register the exact callback URL in the hackathon console.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN/api/auth/callback

# Server-side only. Used by the source-curation script / future Zhihu API proxy.
ZHIHU_ACCESS_SECRET=
